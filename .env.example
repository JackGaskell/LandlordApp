APP_NAME="The Landlord App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Set true to require email verification before using the app (also add MustVerifyEmail on User)
REQUIRE_EMAIL_VERIFICATION=false

# Public landlord signup at /register — keep false in production until launch
REGISTRATION_ENABLED=false

# Automatically invite tenant to the portal when a landlord adds them
AUTO_ENABLE_PORTAL_ON_TENANT_CREATE=true

# Daily time (24h) to sync rent periods before reminders run
RENT_COLLECTION_CYCLE_TIME=07:00

# Daily time (24h) for rent reminder emails (after collection cycle)
REMINDER_DISPATCH_TIME=08:00

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Tenant receipt uploads (bank transfer confirmations). Use s3 in production.
PAYMENT_PROOF_DISK=local

# Queue (use "database" locally; "redis" is common in production)
QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
QUEUE_AFTER_COMMIT=true
QUEUE_DEFAULT=default
QUEUE_REMINDERS=reminders
QUEUE_MAIL=mail
QUEUE_WEBHOOKS=webhooks

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail (pick ONE mode) ---
#
# A) REAL inbox delivery — Resend (recommended; run: composer require resend/resend-php)
# MAIL_MAILER=resend
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM_ADDRESS=onboarding@resend.dev
# (Resend test sender; use your verified domain in production)
#
# B) REAL inbox delivery — Gmail / Office 365 SMTP (no extra packages)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_SCHEME=tls
# MAIL_FROM_ADDRESS=you@gmail.com
#
# C) Local capture only — Mailpit (NOT delivered to Gmail; open http://127.0.0.1:8025)
# MAIL_MAILER=mailpit
# MAILPIT_HOST=127.0.0.1
# MAILPIT_PORT=1025
#
# D) Dev fallback — tries Mailpit, else logs to storage/logs/laravel.log (no real inbox)
MAIL_MAILER=failover
MAILPIT_HOST=127.0.0.1
MAILPIT_PORT=1025

MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@landlordapp.test"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SUPPORT_ADDRESS="support@landlordapp.test"
MAIL_REPLY_TO_ADDRESS="${MAIL_SUPPORT_ADDRESS}"
MAIL_BRAND_COLOR="#3b82f6"
MAIL_CURRENCY_SYMBOL="£"

# Object storage (Laravel Cloud: attach bucket — vars are injected automatically)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Production checklist (Laravel Cloud) ---
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://www.thelandlordapp.com
# APP_TIMEZONE=Europe/London
# REGISTRATION_ENABLED=false
# QUEUE_CONNECTION=database
# PAYMENT_PROOF_DISK=s3
# MAIL_MAILER=resend (or smtp) + verified domain
# Enable: Scheduler (runs rent:run-collection-cycle + rent:dispatch-reminders)
# Enable: Queue worker — php artisan queue:work --queue=webhooks,reminders,default,mail --tries=3 --timeout=90

VITE_APP_NAME="${APP_NAME}"

# Tenant portal card payments (requires STRIPE_ENABLED=true and keys below)
PORTAL_PAY_ONLINE_COMING_SOON=false

STRIPE_ENABLED=false
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUBSCRIPTION_PRICE_ID=
STRIPE_CURRENCY=gbp
# STRIPE_RENT_SUCCESS_URL=/portal?payment=success
# STRIPE_RENT_CANCEL_URL=/portal?payment=cancel
# stripe listen --forward-to http://localhost:8000/stripe/webhook
